# Firebase web config.
#
# These values are public by design. They ship inside the client bundle and
# anyone can read them out of it — that is expected and fine. Security comes
# from firestore.rules, not from hiding this. Don't build a proxy to conceal it.
#
# Copy to .env for local dev, and set the same keys in Vercel → Settings →
# Environment Variables.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
